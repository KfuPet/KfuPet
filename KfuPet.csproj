<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KfuPet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.6</Version>
    <Authors>Grey Bullet Technology Studio</Authors>
    <Company>KfuPet</Company>
    <Product>KfuPet</Product>
    <AssemblyTitle>KfuPet 智能桌面伙伴</AssemblyTitle>
    <Copyright>Copyright (C) 2026 KfuPet</Copyright>
    <FileVersion>$(Version)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon\Startlogo.png" />
    <Resource Include="Assets\icon\app.ico" />
    <Resource Include="Assets\icon\tray.ico" />
    <Resource Include="Assets\Providers\deepseek.ico" />
    <Resource Include="Assets\Providers\kimi.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Characters\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 0.30 的原生库加载依赖 net10 的动态加载，net8 会回退到 netstandard2.0 并加载失败 -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

</Project>
