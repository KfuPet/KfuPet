<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KfuPet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.1</Version>
    <Authors>Grey Bullet Technology Studio</Authors>
    <!-- 界面只有中文，裁剪其他语言的卫星资源程序集，减小发布体积 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon\Startlogo.png" />
    <Resource Include="Assets\icon\app.ico" />
    <Resource Include="Assets\icon\tray.ico" />
    <Resource Include="Assets\Providers\deepseek.ico" />
    <Resource Include="Assets\Providers\kimi.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Characters\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
