<Window x:Class="KfuPet.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        MinWidth="300"
        MaxWidth="380"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,46,0">
                        <TextBlock x:Name="TitleIcon"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIcon}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText"
                                   Margin="10,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右上角关闭按钮：与 Esc 行为一致，按取消处理 -->
                    <Button Style="{StaticResource DialogCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="关闭"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区：状态图标 + 提示文案，窗口随内容自适应 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,0">
                <Border Width="44" Height="44"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource AppSurfaceBrush}">
                    <TextBlock x:Name="BodyIcon"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="{StaticResource FontSizeIconLarge}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Margin="0,12,0,0"
                              MaxHeight="240"
                              Style="{StaticResource OverlayScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               MaxWidth="280"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Visibility="Collapsed"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource AppSuccessBrush}"
                            Foreground="{DynamicResource AppSuccessForegroundBrush}"
                            BorderBrush="{DynamicResource AppSuccessBrush}"
                            Click="ConfirmButton_Click">
                        <TextBlock x:Name="ConfirmText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
