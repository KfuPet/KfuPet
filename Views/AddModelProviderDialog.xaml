<Window x:Class="KfuPet.Views.AddModelProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加模型"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <!-- 服务商条目按钮：图标 + 名称 + 右侧箭头，悬停时整行高亮 -->
        <Style x:Key="ProviderButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标底块 -->
                                <Border Width="36" Height="36"
                                        CornerRadius="8"
                                        Background="White"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Tag}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontFamilyBody}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="{StaticResource FontWeightSemiBold}"
                                           Foreground="{TemplateBinding Foreground}"/>

                                <TextBlock Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="{StaticResource FontFamilyIcon}"
                                           FontSize="{StaticResource FontSizeIconTiny}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Margin="4,1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconTiny}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="14,10,34,10"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"/>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       Placement="Bottom"
                                       PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="240"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：返回按钮仅表单页可见 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button x:Name="BackButton"
                                Width="32" Height="32"
                                Background="Transparent"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Visibility="Collapsed"
                                Click="BackButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE76B;"
                                                   FontFamily="{StaticResource FontFamilyIcon}"
                                                   FontSize="{StaticResource FontSizeIconSmall}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="DialogTitleText"
                                   Text="添加模型"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Width="46" Height="44"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Border x:Name="HoverBg" Background="#E81123" CornerRadius="0,10,0,0" Opacity="0"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIconTiny}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 页 1：服务商列表 -->
            <StackPanel x:Name="ProviderListPanel" Grid.Row="1" Margin="16">
                <Button x:Name="CustomModelButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Click="CustomModelButton_Click">
                    <TextBlock Text="&#xE710;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="{StaticResource FontSizeIconSmall}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Button.Tag>自定义模型</Button.Tag>
                </Button>

                <Button x:Name="DeepSeekButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Click="DeepSeekButton_Click">
                    <Image Source="pack://application:,,,/Assets/Providers/deepseek.ico"
                           Width="22" Height="22"/>
                    <Button.Tag>DeepSeek</Button.Tag>
                </Button>

                <Button x:Name="KimiCnButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Margin="0"
                        Click="KimiCnButton_Click">
                    <Image Source="pack://application:,,,/Assets/Providers/kimi.ico"
                           Width="22" Height="22"/>
                    <Button.Tag>Kimi CN</Button.Tag>
                </Button>
            </StackPanel>

            <!-- 页 2：模型配置表单（通过服务商添加） -->
            <StackPanel x:Name="FormPanel" Grid.Row="1" Margin="20,20,20,0" Visibility="Collapsed">
                <!-- 连接失败提示横幅 -->
                <Border x:Name="ErrorBanner"
                        Margin="0,0,0,14"
                        Padding="12,10"
                        Background="#22E81123"
                        BorderBrush="#E81123"
                        BorderThickness="1"
                        CornerRadius="8"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform Y="-6"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE783;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIcon}"
                                   Foreground="#E81123"
                                   VerticalAlignment="Top"
                                   Margin="0,1,8,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接失败，请检查服务商、Base URL 与 API Key 是否正确"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ErrorDetailText"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="显示名称"/>
                <!-- 服务商：预设只读展示；自定义模型可编辑名称 -->
                <Border x:Name="ProviderReadonlyPanel"
                        Margin="0,0,0,14"
                        Padding="14,10"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ProviderLogo"
                               Width="18" Height="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProviderNameText"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="ProviderNameBox"
                         Style="{StaticResource FieldInputStyle}"
                         Visibility="Collapsed"/>

                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Foreground="#E81123">* </Run><Run Text="模型"/>
                </TextBlock>
                <ComboBox x:Name="ModelCombo" Style="{StaticResource FieldComboStyle}"/>
                <TextBox x:Name="ModelTextBox" Style="{StaticResource FieldInputStyle}" Visibility="Collapsed"/>

                <StackPanel x:Name="BaseUrlPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabelStyle}">
                        <Run Foreground="#E81123">* </Run><Run Text="Base URL"/>
                    </TextBlock>
                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource FieldInputStyle}"/>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0">
                        <Run Foreground="#E81123">* </Run><Run Text="API 密钥"/>
                    </TextBlock>
                    <TextBlock x:Name="GetApiKeyLink"
                               Text="获取 API 密钥"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               MouseLeftButtonUp="GetApiKeyLink_MouseLeftButtonUp"/>
                </Grid>
                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource FieldPasswordStyle}"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="{StaticResource FontSizeIconSmall}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,1,6,0"/>
                    <TextBlock Text="连通性测试会发起一次真实请求，会消耗少量模型Token"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 按钮栏：仅表单页可见 -->
            <Border x:Name="ButtonBar"
                    Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Content="重置"
                            Click="ResetButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource AppSuccessBrush}"
                            Foreground="{DynamicResource AppSuccessForegroundBrush}"
                            BorderBrush="{DynamicResource AppSuccessBrush}"
                            Click="ConfirmButton_Click">
                        <Grid>
                            <TextBlock x:Name="ConfirmText"
                                       Text="添加模型"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="ConfirmSpinner"
                                  Width="16" Height="16"
                                  Data="M 15,8 A 7,7 0 0 1 8,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5"
                                  Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ConfirmSpinnerRotate"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
