<Window x:Class="KfuPet.Views.AddModelProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加模型"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <!-- 页1：服务商条目错峰入场（由代码后置在窗口加载/返回时播放） -->
        <Storyboard x:Key="ProviderItemsStagger">
            <DoubleAnimation Storyboard.TargetName="CustomModelButton"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CustomModelButton"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DeepSeekButton"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DeepSeekButton"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KimiCnButton"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KimiCnButton"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 页2：表单字段错峰入场（由代码后置在切换到表单页时播放） -->
        <Storyboard x:Key="FormFieldsStagger">
            <DoubleAnimation Storyboard.TargetName="NameGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NameGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ModelGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ModelGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BaseUrlGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BaseUrlGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ApiKeyGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ApiKeyGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HintGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HintGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 圆角卡片：Margin 为投影留出空间 -->
    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：返回按钮仅表单页可见 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button x:Name="BackButton"
                                Style="{StaticResource DialogIconButtonStyle}"
                                Visibility="Collapsed"
                                Click="BackButton_Click">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="{DynamicResource FontFamilyIcon}"
                                       FontSize="{DynamicResource FontSizeIconSmall}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        </Button>
                        <TextBlock x:Name="DialogTitleText"
                                   Text="添加模型"
                                   Margin="8,0,0,0"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="{DynamicResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 页 1：服务商列表 -->
            <StackPanel x:Name="ProviderListPanel" Grid.Row="1" Margin="16">
                <Button x:Name="CustomModelButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Click="CustomModelButton_Click">
                    <Button.RenderTransform>
                        <TranslateTransform/>
                    </Button.RenderTransform>
                    <TextBlock Text="&#xE710;"
                               FontFamily="{DynamicResource FontFamilyIcon}"
                               FontSize="{DynamicResource FontSizeIconSmall}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Button.Tag>自定义模型</Button.Tag>
                </Button>

                <Button x:Name="DeepSeekButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Click="DeepSeekButton_Click">
                    <Button.RenderTransform>
                        <TranslateTransform/>
                    </Button.RenderTransform>
                    <Image Source="pack://application:,,,/Assets/Providers/deepseek.ico"
                           Width="22" Height="22"/>
                    <Button.Tag>DeepSeek</Button.Tag>
                </Button>

                <Button x:Name="KimiCnButton"
                        Style="{StaticResource ProviderButtonStyle}"
                        Margin="0"
                        Click="KimiCnButton_Click">
                    <Button.RenderTransform>
                        <TranslateTransform/>
                    </Button.RenderTransform>
                    <Image Source="pack://application:,,,/Assets/Providers/kimi.ico"
                           Width="22" Height="22"/>
                    <Button.Tag>Kimi CN</Button.Tag>
                </Button>
            </StackPanel>

            <!-- 页 2：模型配置表单 -->
            <StackPanel x:Name="FormPanel" Grid.Row="1" Margin="20,20,20,0" Visibility="Collapsed">
                <!-- 连接失败提示横幅：默认隐藏，失败时淡入并轻微下滑 -->
                <Border x:Name="ErrorBanner"
                        Style="{StaticResource DialogErrorBannerStyle}"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform Y="-6"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE783;"
                                   FontFamily="{DynamicResource FontFamilyIcon}"
                                   FontSize="{DynamicResource FontSizeIcon}"
                                   Foreground="#E81123"
                                   VerticalAlignment="Top"
                                   Margin="0,1,8,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接失败，请检查服务商、Base URL 与 API Key 是否正确"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="{DynamicResource FontWeightSemiBold}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ErrorDetailText"
                                       Margin="0,4,0,0"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="NameGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="显示名称"/>
                        <!-- 服务商：预设只读展示；自定义模型可编辑名称 -->
                        <Border x:Name="ProviderReadonlyPanel"
                                Margin="0,0,0,14"
                                Padding="14,10"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ProviderLogo"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProviderNameText"
                                           FontFamily="{DynamicResource FontFamilyBody}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ProviderNameBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ModelGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}">
                            <Run Foreground="#E81123">* </Run><Run Text="模型"/>
                        </TextBlock>
                        <!-- 预设服务商：先点击刷新按钮拉取模型列表，成功后切换为可展开的下拉框 -->
                        <Grid x:Name="ModelFetchPanel" Margin="0,0,0,14">
                            <Border Padding="14,10,44,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Text="请先输入 API 密钥才能获取模型列表"
                                           FontFamily="{DynamicResource FontFamilyBody}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button x:Name="ModelRefreshButton"
                                    Style="{StaticResource DialogIconButtonStyle}"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="获取模型列表"
                                    Click="ModelRefreshButton_Click">
                                <TextBlock x:Name="ModelRefreshIcon"
                                           Text="&#xE72C;"
                                           FontFamily="{DynamicResource FontFamilyIcon}"
                                           FontSize="{DynamicResource FontSizeIconSmall}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <!-- 预设：拉取成功后的模型下拉框 -->
                        <ComboBox x:Name="ModelCombo"
                                  Style="{StaticResource FieldComboStyle}"
                                  Visibility="Collapsed"/>
                        <!-- 自定义模型：可手动输入，也可从后台拉取的列表中选择 -->
                        <ComboBox x:Name="ModelCustomCombo"
                                  Style="{StaticResource FieldComboStyle}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  DropDownOpened="ModelCustomCombo_DropDownOpened"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="BaseUrlGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel x:Name="BaseUrlPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabelStyle}">
                            <Run Foreground="#E81123">* </Run><Run Text="Base URL"/>
                        </TextBlock>
                        <TextBox x:Name="BaseUrlBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 LostFocus="BaseUrlBox_LostFocus"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ApiKeyGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0">
                                <Run Foreground="#E81123">* </Run><Run Text="API 密钥"/>
                            </TextBlock>
                            <TextBlock x:Name="GetApiKeyLink"
                                       Text="获取 API 密钥"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextDecorations="Underline"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="GetApiKeyLink_MouseLeftButtonUp"/>
                        </Grid>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Style="{StaticResource FieldPasswordStyle}"
                                     LostFocus="ApiKeyBox_LostFocus"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="HintGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="{DynamicResource FontFamilyIcon}"
                                   FontSize="{DynamicResource FontSizeIconSmall}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Margin="0,1,6,0"/>
                        <TextBlock Text="连通性测试会发起一次真实请求，会消耗少量模型Token"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 按钮栏：仅表单页可见 -->
            <Border x:Name="ButtonBar"
                    Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Content="重置"
                            Click="ResetButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource AppSuccessBrush}"
                            Foreground="{DynamicResource AppSuccessForegroundBrush}"
                            BorderBrush="{DynamicResource AppSuccessBrush}"
                            Click="ConfirmButton_Click">
                        <Grid>
                            <TextBlock x:Name="ConfirmText"
                                       Text="添加模型"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="ConfirmSpinner"
                                  Width="16" Height="16"
                                  Data="M 15,8 A 7,7 0 0 1 8,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5"
                                  Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ConfirmSpinnerRotate"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>