<Window x:Class="KfuPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{DynamicResource AppBorderBrush}"
                                CornerRadius="12">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="设置"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="20,24,20,20"/>

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="Margin" Value="12,2"/>
                            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
                            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBoxItem Content="模型配置"/>
                    <ListBoxItem Content="开发者模式"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" Margin="28,28,28,24">
            <!-- 模型配置页 -->
            <StackPanel x:Name="ModelConfigPanel">
                <TextBlock Text="模型配置" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="配置 AI 服务商与模型，保存功能将在后续版本提供。"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,6,0,20"/>

                <TextBlock Text="服务商" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="ProviderBox" Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Text="Base URL" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="BaseUrlBox" Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox x:Name="ApiKeyBox"
                             Margin="0,0,0,18"
                             Padding="10,8"
                             Background="{DynamicResource AppSurfaceBrush}"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             FontFamily="{StaticResource FontFamilyBody}"
                             FontSize="{StaticResource FontSizeCaption}"/>

                <TextBlock Text="模型名称" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="ModelBox" Style="{StaticResource FieldInputStyle}"/>
            </StackPanel>

            <!-- 开发者模式页 -->
            <StackPanel x:Name="DeveloperPanel" Visibility="Collapsed">
                <TextBlock Text="开发者模式" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="启用后可使用面向开发者的高级功能。"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,6,0,24"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="启用开发者模式"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="DeveloperModeToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="12,0,0,0"
                                  Checked="DeveloperModeToggle_Changed"
                                  Unchecked="DeveloperModeToggle_Changed"/>
                </StackPanel>

                <TextBlock x:Name="ToolStatusText"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
