                            <TextBlock Text="开发者模式" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- 选项卡片：标签居左，开关统一居右 -->
                            <Border Margin="0,16,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <TextBlock Text="启用开发者模式"
                                               FontFamily="{StaticResource FontFamilyBody}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="DeveloperModeToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Checked="DeveloperModeToggle_Changed"
                                                  Unchecked="DeveloperModeToggle_Changed"/>
                                </Grid>
                            </Border>

                            <Border x:Name="DebugBonesPanel"
                                    Margin="0,8,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Opacity="0"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="DebugBonesPanelTranslate"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <TextBlock Text="显示骨骼调试线框"
                                               FontFamily="{StaticResource FontFamilyBody}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="DebugBonesToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Checked="DebugBonesToggle_Changed"
                                                  Unchecked="DebugBonesToggle_Changed"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ToolStatusText"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 关于页 -->
                    <ScrollViewer x:Name="AboutPanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- 软件信息卡片：图标 + 名称 + 版本徽章，下方为操作按钮 -->
                            <Border Margin="0,16,0,0"
                                    Padding="18,16"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/icon/Startlogo.png"
                                               Width="56" Height="56"/>
                                        <TextBlock Text="KfuPet"
                                                   Margin="14,0,0,0"
                                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <!-- 版本徽章：底色用边框色，比卡片面深一档以便区分；连续点击 5 次可唤出开发者模式入口 -->
                                        <Border Margin="10,0,0,0"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AppBorderBrush}"
                                                CornerRadius="6"
                                                MouseLeftButtonUp="VersionBadge_MouseLeftButtonUp">
                                            <TextBlock x:Name="VersionText"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 操作按钮组：检查更新 / 打开日志 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="CheckUpdateButton"
                                                Style="{StaticResource AboutActionButtonStyle}"
                                                Click="CheckUpdateButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="检查更新"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="OpenLogButton"
                                                Style="{StaticResource AboutActionButtonStyle}"
                                                Margin="8,0,0,0"
                                                Click="OpenLogButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="打开日志"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 分隔线：负边距抵消卡片 Padding，使线条横贯卡片 -->
                                    <Border Height="1"
                                            Margin="-18,16,-18,0"
                                            Background="{DynamicResource AppBorderBrush}"/>

                                    <!-- 关于此版本 / 关于新版本（检测到新版本时切换）：默认折叠，点击头部展开显示对应版本的更新内容 -->
                                    <Border x:Name="AboutCurrentVersionHeader"
                                            Margin="-6,6,-6,0"
                                            Padding="6,8"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            RenderTransformOrigin="0.5,0.5"
                                            MouseEnter="AboutCurrentVersionHeader_MouseEnter"
                                            MouseLeave="AboutCurrentVersionHeader_MouseLeave"
                                            MouseLeftButtonDown="AboutCurrentVersionHeader_MouseDown"
                                            MouseLeftButtonUp="AboutCurrentVersionHeader_Click">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="AboutCurrentVersionHeaderScale"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 悬停高亮层：负边距覆盖到外层 Padding 区域，淡入淡出 -->
                                            <Border x:Name="AboutCurrentVersionHoverOverlay"
                                                    Grid.ColumnSpan="4"
                                                    Margin="-6,-8"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AppBorderBrush}"
                                                    Opacity="0"/>
                                            <TextBlock x:Name="AboutVersionTitle"
                                                       Text="关于此版本"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 当前版本徽章：与上方版本徽章同款 -->
                                            <Border x:Name="CurrentVersionBadgeBorder"
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AppBorderBrush}"
                                                    CornerRadius="6"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="CurrentVersionBadgeScale"/>
                                                </Border.RenderTransform>
                                                <TextBlock x:Name="CurrentVersionBadge"
                                                           Text="···"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="CurrentReleaseDateText"
                                                       Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="CurrentReleaseDateSlide"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutCurrentVersionChevron"
                                                       Grid.Column="3"
                                                       Text="&#xE76B;"
                                                       FontFamily="{StaticResource FontFamilyIcon}"
                                                       FontSize="{StaticResource FontSizeIconSmall}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="AboutCurrentVersionChevronRotate"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- 展开区域：对应版本（本机版本 / 新版本）的更新内容 -->
                                    <Border x:Name="AboutCurrentVersionContent"
                                            Visibility="Collapsed"
                                            Opacity="0"
                                            Margin="0,2,0,4"
                                            Padding="12,10"
                                            Background="{DynamicResource AppBorderBrush}"
                                            CornerRadius="8">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="AboutCurrentVersionContentSlide"/>
                                        </Border.RenderTransform>
                                        <ScrollViewer MaxHeight="220"
                                                      VerticalScrollBarVisibility="Auto">
                                            <!-- 更新说明是 Markdown 文本，由 MarkdownRenderer 渲染成富文本块 -->
                                            <StackPanel x:Name="CurrentReleaseNotesPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 项目介绍卡片 -->
                            <Border Margin="0,12,0,0"
                                    Padding="18,20"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <StackPanel>
                                    <TextBlock Text="项目介绍"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource FontFamilyDisplay}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="{StaticResource FontWeightSemiBold}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="KfuPet 是一个 AI 驱动的二次元桌面宠物平台。她住在你的桌面上，可以陪你聊天互动，未来还会逐步拥有记忆、情感、骨骼动画、插件扩展等能力，成为一个真正懂你的桌面伙伴。"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,12,0,0"
                                               FontFamily="{StaticResource FontFamilyBody}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 存储占用页 -->
                    <ScrollViewer x:Name="StoragePanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="存储占用"
                                           Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center"/>
                                <!-- 缓存清理按钮：红色危险操作，位于标题行右侧 -->
                                <Button x:Name="CleanupCacheButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="12,7"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        Click="CleanupCacheButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="#E81123"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="BtnScale"/>
                                                </Border.RenderTransform>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;"
                                                               FontFamily="{StaticResource FontFamilyIcon}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="缓存清理"
                                                               FontFamily="{StaticResource FontFamilyBody}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#F32F41" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#E81123" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="0.95" Duration="0:0:0.08"/>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="0.95" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 概览卡片：软件本体 / 缓存数据 / 模型包 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 软件本体卡片 -->
                                <Border x:Name="StorageInstallCard"
                                        Grid.Column="0"
                                        Padding="14,12"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="StorageInstallCardTransform"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AppBorderBrush}">
                                                <TextBlock Text="&#xE7C3;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="软件本体"
                                                       Margin="8,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StorageInstallSizeText"
                                                   Text="—"
                                                   Margin="0,10,0,0"
                                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="程序文件、运行依赖与资源"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 缓存数据卡片 -->
                                <Border x:Name="StorageCacheCard"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="14,12"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="StorageCacheCardTransform"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AppBorderBrush}">
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="缓存数据"
                                                       Margin="8,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StorageCacheSizeText"
                                                   Text="—"
                                                   Margin="0,10,0,0"
                                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="软件配置、记忆与日志"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 模型包卡片：Characters 下全部模型包的合计占用 -->
                                <Border x:Name="StorageModelsCard"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="14,12"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="StorageModelsCardTransform"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <!-- 标题行：左侧图标 + 名称，右侧“前往清理”入口 -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppBorderBrush}">
                                                    <TextBlock Text="&#xE753;"
                                                               FontFamily="{StaticResource FontFamilyIcon}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="模型包"
                                                           Margin="8,0,0,0"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="OpenCharacterGalleryButton"
                                                    Style="{StaticResource AboutActionButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Padding="10,5"
                                                    Click="OpenCharacterGalleryButton_Click">
                                                <TextBlock Text="前往清理"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="StorageModelsSizeText"
                                                   Text="—"
                                                   Margin="0,10,0,0"
                                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                                   FontSize="{StaticResource FontSizeTitle}"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock x:Name="StorageModelsCountText"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 模型包明细：多于一个模型包时显示占用最大的 3 个 -->
                            <Border x:Name="StoragePackagesCard"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0"
                                    Padding="16,14"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="StoragePackagesCardTransform"/>
                                </Border.RenderTransform>
                                <StackPanel>
                                    <TextBlock Text="模型包占用明细"
                                               FontFamily="{StaticResource FontFamilyDisplay}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="按占用大小排序，最多显示 3 个。"
                                               Margin="0,4,0,0"
                                               FontFamily="{StaticResource FontFamilyBody}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                    <!-- 明细行 1：名称 + 大小 + 相对占比条 -->
                                    <StackPanel x:Name="StoragePackageRow1" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="StoragePackageRow1Name"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StoragePackageRow1Size"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Height="4"
                                                CornerRadius="2"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource AppBorderBrush}">
                                            <Border CornerRadius="2"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="StoragePackageRow1Fill" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>

                                    <!-- 明细行 2 -->
                                    <StackPanel x:Name="StoragePackageRow2" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="StoragePackageRow2Name"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StoragePackageRow2Size"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Height="4"
                                                CornerRadius="2"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource AppBorderBrush}">
                                            <Border CornerRadius="2"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="StoragePackageRow2Fill" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>

                                    <!-- 明细行 3 -->
                                    <StackPanel x:Name="StoragePackageRow3" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="StoragePackageRow3Name"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StoragePackageRow3Size"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Height="4"
                                                CornerRadius="2"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource AppBorderBrush}">
                                            <Border CornerRadius="2"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="StoragePackageRow3Fill" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 飘窗提示：页面下方居中浮出，由代码控制显隐动画，不拦截鼠标 -->
            <Border x:Name="ToastCard"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,28"
                    Padding="16,10"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTranslate" Y="16"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="{StaticResource FontSizeIconSmall}"
                               Foreground="{DynamicResource AppAccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastText"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 主题切换遮罩：先以旧背景色盖住卡片，换色后淡出，避免透明窗口闪透明 -->
            <Border x:Name="ThemeTransitionOverlay"
                    Grid.RowSpan="2"
                    CornerRadius="11"
                    Opacity="0"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
