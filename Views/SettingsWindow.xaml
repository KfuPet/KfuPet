<Window x:Class="KfuPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="960"
        Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 标题栏关闭按钮：悬停时红色背景淡入，右上角跟随窗口圆角 -->
        <Style x:Key="TitleBarCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="HoverBg" Background="#E81123" CornerRadius="0,10,0,0" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框：圆角，悬停/聚焦时描边环淡入（叠加层方案，兼容主题画刷） -->
        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverRing"
                                        BorderBrush="{DynamicResource AppTextDisabledBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Opacity="0"/>
                                <Border x:Name="FocusRing"
                                        BorderBrush="{DynamicResource AppAccentBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Opacity="0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码框：与输入框同款外观（WPF 模板无法跨控件类型复用，故分开定义） -->
        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverRing"
                                        BorderBrush="{DynamicResource AppTextDisabledBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Opacity="0"/>
                                <Border x:Name="FocusRing"
                                        BorderBrush="{DynamicResource AppAccentBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Opacity="0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关：滑块缓动滑动 + 拇指弹性缩放回弹，轨道强调色淡入淡出 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="{DynamicResource AppBorderBrush}"
                                CornerRadius="12">
                            <Grid>
                                <Border x:Name="TrackOn"
                                        Background="{DynamicResource AppSuccessBrush}"
                                        CornerRadius="12"
                                        Opacity="0"/>
                                <Ellipse x:Name="Thumb"
                                         Width="18" Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="ThumbTransform"/>
                                            <ScaleTransform x:Name="ThumbScale" CenterX="9" CenterY="9"/>
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.25">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.25">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale"
                                                                           Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.2">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbScale"
                                                                           Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.2">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关于页操作按钮：圆角描边，悬停时描边变强调色；图标与文字由使用处放进 Content -->
        <Style x:Key="AboutActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条分页按钮：透明占位，仅保留滚动功能 -->
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条滑块：圆角细条，悬停强调色 -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource AppBorderBrush}"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：overlay 悬浮在内容上方，不挤压布局 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 自定义 ScrollViewer：滚动条悬浮在内容上方，不占用布局空间 -->
        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Width="6"
                                       Margin="0,4,2,4"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Bottom"
                                       Height="6"
                                       Margin="4,0,4,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模型列表项：圆角卡片，左侧名称，右侧删除按钮 + 开关 -->
        <Style x:Key="ModelItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ModelCard"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 模型名称（绑定 Content，支持字符串或 ListBoxItem） -->
                                <TextBlock x:Name="ModelNameText"
                                           Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           FontFamily="{StaticResource FontFamilyBody}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- 编辑按钮 -->
                                <Button x:Name="EditModelButton"
                                        Grid.Column="1"
                                        Width="32" Height="32"
                                        Margin="8,0,4,0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="编辑模型">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="EditBg"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="6">
                                                <Path x:Name="EditIcon"
                                                      Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                      Fill="{DynamicResource AppTextSecondaryBrush}"
                                                      Stretch="Uniform"
                                                      Width="14" Height="14"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="EditBg"
                                                            Property="Background"
                                                            Value="{DynamicResource AppBorderBrush}"/>
                                                    <Setter TargetName="EditIcon"
                                                            Property="Fill"
                                                            Value="{DynamicResource AppAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 删除按钮（界面完整，点击由后台代码处理） -->
                                <Button x:Name="DeleteModelButton"
                                        Grid.Column="2"
                                        Width="32" Height="32"
                                        Margin="0,0,8,0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="删除模型">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DeleteBg"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="6">
                                                <Path x:Name="DeleteIcon"
                                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                      Fill="{DynamicResource AppTextSecondaryBrush}"
                                                      Stretch="Uniform"
                                                      Width="14" Height="14"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DeleteBg"
                                                            Property="Background"
                                                            Value="{DynamicResource AppBorderBrush}"/>
                                                    <Setter TargetName="DeleteIcon"
                                                            Property="Fill"
                                                            Value="#E81123"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 开关：切换当前使用的模型 -->
                                <ToggleButton x:Name="ModelToggle"
                                              Grid.Column="3"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉菜单项样式：图标（Tag 携带字形）+ 文字 + 选中对勾，悬停底色高亮；供「通用」页外观选择与「模型功能」页的节省选项共用 -->
        <Style x:Key="AppearanceComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource FontFamilyIcon}"
                                           FontSize="{StaticResource FontSizeIconSmall}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="2"
                                           Text="&#xE73E;"
                                           FontFamily="{StaticResource FontFamilyIcon}"
                                           FontSize="{StaticResource FontSizeIconTiny}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉菜单：圆角按钮 + 弹出层淡入下滑，箭头随展开旋转 -->
        <Style x:Key="AppearanceComboStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AppearanceComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 当前选中项图标（字形存在各选项的 Tag 里） -->
                                                <TextBlock Text="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           Margin="0,0,7,0"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                  Margin="0,0,20,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Chevron"
                                                           Grid.Column="2"
                                                           Text="&#xE70D;"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="{StaticResource FontSizeIconTiny}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppTextDisabledBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                             Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="180" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                             Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             To="0" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   VerticalOffset="0"
                                   AllowsTransparency="True"
                                   PopupAnimation="None">
                                <Border x:Name="PopupCard"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="-6"/>
                                    </Border.RenderTransform>
                                    <!-- 限高滚动：候选项多时（如小时选择）不撑出屏幕 -->
                                    <ScrollViewer MaxHeight="240"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" Margin="4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PopupCard"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="PopupCard"
                                                             Storyboard.TargetProperty="RenderTransform.Y"
                                                             From="-6" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 圆角卡片：Margin 为投影留出空间，窗口透明区域点击穿透 -->
    <Border x:Name="RootCard"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（可拖动；Background 让整个标题栏参与命中测试） -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/Assets/icon/app.ico"
                               Width="18" Height="18"/>
                        <TextBlock Text="设置"
                                   Margin="10,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIconTiny}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏（左下角跟随窗口圆角） -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,11">
                    <DockPanel LastChildFill="True">
                        <!-- 导航项样式：上方功能导航与底部“存储占用”入口共用 -->
                        <DockPanel.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="12,2"/>
                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
                                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- 背景层放在内容 Padding 外侧，铺满整个选项槽位，上下选项背景之间无间隙 -->
                                            <Grid>
                                                <Border x:Name="HoverBg"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        CornerRadius="8"
                                                        Opacity="0"/>
                                                <Border x:Name="SelectedBg"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        CornerRadius="8"
                                                        Opacity="0"/>
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="12,8">
                                                    <Grid>
                                                        <Border x:Name="Indicator"
                                                                Width="3" Height="18"
                                                                CornerRadius="1.5"
                                                                HorizontalAlignment="Left"
                                                                Margin="-6,0,0,0"
                                                                Background="{DynamicResource AppAccentBrush}"
                                                                Opacity="0"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleY="0.3"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SelectedBg"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.18"/>
                                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.18"/>
                                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                                 To="1" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SelectedBg"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                                 To="0.3" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DockPanel.Resources>

                        <!-- 存储占用入口：固定在侧栏底部，不参与上方功能导航排序 -->
                        <ListBox x:Name="StorageNavList"
                                 DockPanel.Dock="Bottom"
                                 Margin="0,0,0,6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="StorageNavList_SelectionChanged">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="存储占用" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <ListBox x:Name="NavList"
                                 Margin="0,12,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="通用" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="模型" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="模型功能" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="记忆" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!-- 开发者模式入口：默认隐藏，通过“关于”页版本徽章连续点击 5 次唤出 -->
                            <ListBoxItem x:Name="DeveloperNavItem" Visibility="Collapsed">
                                <ListBoxItem.RenderTransform>
                                    <TranslateTransform/>
                                </ListBoxItem.RenderTransform>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC7A;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="开发者模式" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="{StaticResource FontFamilyIcon}"
                                               FontSize="{StaticResource FontSizeIcon}" Width="26"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="关于" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Grid Grid.Column="1" Margin="28,20,28,24">
                    <!-- 通用页 -->
                    <ScrollViewer x:Name="GeneralPanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="通用" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- 外观卡片：标签居左，浅色/深色分段选择器居右 -->
                            <Border Margin="0,16,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="外观"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- 外观下拉菜单：系统 / 浅色 / 深色 -->
                                    <ComboBox x:Name="AppearanceComboBox"
                                              Style="{StaticResource AppearanceComboStyle}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              SelectionChanged="AppearanceComboBox_SelectionChanged">
                                        <ComboBoxItem Content="系统" Tag="&#xE770;"/>
                                        <ComboBoxItem Content="浅色" Tag="&#xE706;"/>
                                        <ComboBoxItem Content="深色" Tag="&#xE708;"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 开机自启动卡片：标签居左，开关居右 -->
                            <Border Margin="0,8,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="开机自启动"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>

                                    <ToggleButton x:Name="AutoStartToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Checked="AutoStartToggle_Changed"
                                                  Unchecked="AutoStartToggle_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 模型页（内容超出时可滚动，滚动条悬浮不挤压布局） -->
                    <ScrollViewer x:Name="ModelConfigPanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <!-- 标题栏 + 添加按钮 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="模型"
                                           Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="AddModelButton"
                                        Grid.Column="1"
                                        Padding="14,8"
                                        Background="{DynamicResource AppSuccessBrush}"
                                        Foreground="{DynamicResource AppSuccessForegroundBrush}"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        Click="AddModelButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="AddBg"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;"
                                                               FontFamily="{StaticResource FontFamilyIcon}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="添加模型"
                                                               FontFamily="{StaticResource FontFamilyBody}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="{StaticResource FontWeightSemiBold}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AddBg"
                                                            Property="Background"
                                                            Value="{DynamicResource AppSuccessHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 模型列表（数据由 ModelConfigService 本地持久化） -->
                            <ItemsControl x:Name="ModelList"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ItemContainerStyle="{StaticResource ModelItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock x:Name="ModelEmptyText"
                                       Text="还没有添加任何模型，点击上方“添加模型”按钮开始配置。"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 模型功能页 -->
                    <ScrollViewer x:Name="ModelFeaturesPanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <!-- 分段滑块按钮：文字选项，选中态由背后的滑块承载 -->
                            <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
                                <Setter Property="Width" Value="68"/>
                                <Setter Property="Padding" Value="0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}"/>
                                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="模型功能" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- 节省模型消耗卡片：标签居左（带说明问号），关闭 / 开启 / 自定义滑块居右 -->
                            <Border Margin="0,16,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="节省模型消耗"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- 说明问号：悬停显示各档位的含义 -->
                                        <TextBlock Text="&#xE9CE;"
                                                   FontFamily="{StaticResource FontFamilyIcon}"
                                                   FontSize="{StaticResource FontSizeIconSmall}"
                                                   Cursor="Help"
                                                   Margin="6,1,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="320">
                                                    <TextBlock TextWrapping="Wrap"
                                                               Text="关闭：保持现状，触摸反应、更新通知文案、越界回正文案与主动搭话由 AI 生成。&#x0a;开启：这些功能改用本地文案，不再消耗模型请求。&#x0a;自定义：分别设置每个功能是否使用 AI 生成。"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 分段滑块：关闭 / 开启 / 自定义，选中项由滑块承载 -->
                                    <Border x:Name="SavingModeSegmented"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="17"
                                            Padding="3">
                                        <Grid x:Name="SavingModeTrack">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 滑块：随选中项左右滑动 -->
                                            <Border x:Name="SavingModeThumb"
                                                    Grid.Column="0"
                                                    Background="{DynamicResource AppBorderBrush}"
                                                    CornerRadius="14"
                                                    SizeChanged="SavingModeThumb_SizeChanged">
                                                <Border.RenderTransform>
                                                    <TranslateTransform/>
                                                </Border.RenderTransform>
                                            </Border>

                                            <RadioButton x:Name="SavingOffRadio"
                                                         Grid.Column="0"
                                                         Style="{StaticResource SegmentButtonStyle}"
                                                         Content="关闭"
                                                         Checked="SavingModeRadio_Checked"/>
                                            <RadioButton x:Name="SavingOnRadio"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SegmentButtonStyle}"
                                                         Content="开启"
                                                         Checked="SavingModeRadio_Checked"/>
                                            <RadioButton x:Name="SavingCustomRadio"
                                                         Grid.Column="2"
                                                         Style="{StaticResource SegmentButtonStyle}"
                                                         Content="自定义"
                                                         Checked="SavingModeRadio_Checked"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 自定义细分：仅自定义模式显示，三项功能分别选择是否使用 AI 生成 -->
                            <StackPanel x:Name="CustomSavingOptionsPanel"
                                        Visibility="Collapsed"
                                        Opacity="0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>

                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="触摸反应"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <ComboBox x:Name="TouchReactionSavingComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource AppearanceComboStyle}"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="TouchReactionSavingComboBox_SelectionChanged">
                                            <ComboBoxItem Content="AI 生成" Tag="&#xE8BD;"/>
                                            <ComboBoxItem Content="角色台词" Tag="&#xE8A5;"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="更新通知文案"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <ComboBox x:Name="UpdateNotificationSavingComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource AppearanceComboStyle}"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="UpdateNotificationSavingComboBox_SelectionChanged">
                                            <ComboBoxItem Content="AI 生成" Tag="&#xE8BD;"/>
                                            <ComboBoxItem Content="内置文案" Tag="&#xE8A5;"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="越界回正文案"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <ComboBox x:Name="SnapBackSavingComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource AppearanceComboStyle}"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="SnapBackSavingComboBox_SelectionChanged">
                                            <ComboBoxItem Content="AI 生成" Tag="&#xE8BD;"/>
                                            <ComboBoxItem Content="角色台词" Tag="&#xE8A5;"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="主动搭话"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <ComboBox x:Name="ProactiveChatSavingComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource AppearanceComboStyle}"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="ProactiveChatSavingComboBox_SelectionChanged">
                                            <ComboBoxItem Content="AI 生成" Tag="&#xE8BD;"/>
                                            <ComboBoxItem Content="角色台词" Tag="&#xE8A5;"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 主动搭话：总开关默认开启，其余参数随总开关显隐 -->
                            <TextBlock Text="主动搭话"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,24,0,0"/>

                            <Border Margin="0,16,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="允许主动找主人聊天"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="&#xE9CE;"
                                                   FontFamily="{StaticResource FontFamilyIcon}"
                                                   FontSize="{StaticResource FontSizeIconSmall}"
                                                   Cursor="Help"
                                                   Margin="6,1,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="320">
                                                    <TextBlock TextWrapping="Wrap"
                                                               Text="桌宠会在合适的时候主动开口：久未互动时找你说话、你离开后回来时欢迎你、早晚各问候一次。&#x0a;安静时段与冷却会自动避免打扰，你正在打字或聊天时绝不插话。"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </StackPanel>

                                    <ToggleButton x:Name="ProactiveChatToggle"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Checked="ProactiveChatToggle_Changed"
                                                  Unchecked="ProactiveChatToggle_Changed"/>
                                </Grid>
                            </Border>

                            <!-- 主动搭话参数：仅总开关开启时显示 -->
                            <StackPanel x:Name="ProactiveOptionsPanel"
                                        Visibility="Collapsed"
                                        Opacity="0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>

                                <!-- 触发频率：低 / 中 / 高，选中项由滑块承载 -->
                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="触发频率"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="&#xE9CE;"
                                                       FontFamily="{StaticResource FontFamilyIcon}"
                                                       FontSize="{StaticResource FontSizeIconSmall}"
                                                       Cursor="Help"
                                                       Margin="6,1,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.ToolTip>
                                                    <ToolTip MaxWidth="320">
                                                        <TextBlock TextWrapping="Wrap"
                                                                   Text="决定久未互动多久后可能开口、两次开口至少间隔多久：&#x0a;低：约 2–3 小时一句；中：约 1–1.5 小时一句；高：约 30–40 分钟一句。&#x0a;实际是否开口还带随机概率，不会机械定时。"/>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border x:Name="ProactiveFrequencySegmented"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="17"
                                                Padding="3">
                                            <Grid x:Name="ProactiveFrequencyTrack">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="ProactiveFrequencyThumb"
                                                        Grid.Column="0"
                                                        Background="{DynamicResource AppBorderBrush}"
                                                        CornerRadius="14"
                                                        SizeChanged="ProactiveFrequencyThumb_SizeChanged">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                </Border>

                                                <RadioButton x:Name="ProactiveLowRadio"
                                                             Grid.Column="0"
                                                             Style="{StaticResource SegmentButtonStyle}"
                                                             Content="低"
                                                             Checked="ProactiveFrequencyRadio_Checked"/>
                                                <RadioButton x:Name="ProactiveMediumRadio"
                                                             Grid.Column="1"
                                                             Style="{StaticResource SegmentButtonStyle}"
                                                             Content="中"
                                                             Checked="ProactiveFrequencyRadio_Checked"/>
                                                <RadioButton x:Name="ProactiveHighRadio"
                                                             Grid.Column="2"
                                                             Style="{StaticResource SegmentButtonStyle}"
                                                             Content="高"
                                                             Checked="ProactiveFrequencyRadio_Checked"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 安静时段：支持跨午夜，可用右侧开关随时关闭 -->
                                <Border Margin="0,8,0,0"
                                        Padding="14,14"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="安静时段"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="&#xE9CE;"
                                                       FontFamily="{StaticResource FontFamilyIcon}"
                                                       FontSize="{StaticResource FontSizeIconSmall}"
                                                       Cursor="Help"
                                                       Margin="6,1,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.ToolTip>
                                                    <ToolTip MaxWidth="320">
                                                        <TextBlock TextWrapping="Wrap"
                                                                   Text="这段时间内不会主动开口。结束时间早于开始时间时表示跨午夜（如默认 23:00 至次日 8:00）：结束列表里这些时间会标注“次日”。&#x0a;不想用安静时段时，直接关掉右侧开关即可。"/>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- 时间选择：仅开关开启时显示；开始 / 结束各带标题，结束列表里跨午夜的时间标注“次日” -->
                                            <Grid x:Name="QuietHoursOptionsPanel"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"
                                                  Opacity="0">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform/>
                                                </Grid.RenderTransform>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="开始"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="2"
                                                           Text="结束"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           Margin="0,0,0,6"/>

                                                <ComboBox x:Name="QuietHoursStartComboBox"
                                                          Grid.Row="1"
                                                          Grid.Column="0"
                                                          Style="{StaticResource AppearanceComboStyle}"
                                                          VerticalAlignment="Center"
                                                          SelectionChanged="QuietHoursComboBox_SelectionChanged"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="至"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox x:Name="QuietHoursEndComboBox"
                                                          Grid.Row="1"
                                                          Grid.Column="2"
                                                          Style="{StaticResource AppearanceComboStyle}"
                                                          VerticalAlignment="Center"
                                                          SelectionChanged="QuietHoursComboBox_SelectionChanged"/>
                                            </Grid>

                                            <ToggleButton x:Name="QuietHoursToggle"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Checked="QuietHoursToggle_Changed"
                                                          Unchecked="QuietHoursToggle_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 久未互动时主动搭话 -->
                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <TextBlock Text="久未互动时主动搭话"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <ToggleButton x:Name="ProactiveIdleToggle"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Checked="ProactiveIdleToggle_Changed"
                                                      Unchecked="ProactiveIdleToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- 离开回来后欢迎 -->
                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <TextBlock Text="离开回来后欢迎"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <ToggleButton x:Name="ProactiveWelcomeToggle"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Checked="ProactiveWelcomeToggle_Changed"
                                                      Unchecked="ProactiveWelcomeToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- 每天早晚问候 -->
                                <Border Margin="0,8,0,0"
                                        Padding="14,10"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <TextBlock Text="每天早晚问候"
                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <ToggleButton x:Name="ProactiveGreetingToggle"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Checked="ProactiveGreetingToggle_Changed"
                                                      Unchecked="ProactiveGreetingToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 记忆页 -->
                    <ScrollViewer x:Name="MemoryPanel"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform/>
                        </ScrollViewer.RenderTransform>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="记忆" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- 记忆概览：三级记忆状态卡片（数字滚动 + 进度条缓动填充） -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 短期记忆卡片 -->
                                <Border x:Name="ShortMemoryCard"
                                        Grid.Column="0"
                                        Padding="14,12"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ShortCardTransform"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppBorderBrush}">
                                                    <TextBlock Text="&#xE917;"
                                                               FontFamily="{StaticResource FontFamilyIcon}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="短期记忆"
                                                           Margin="8,0,0,0"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock x:Name="ShortCountText"
                                                           Text="0"
                                                           FontFamily="{StaticResource FontFamilyDisplay}"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="{StaticResource FontWeightSemiBold}"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock x:Name="ShortLimitText"
                                                           Text="/ 20"
                                                           Margin="4,0,0,2"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource AppTextDisabledBrush}"
                                                           VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                            <TextBlock Text="最近对话的即时上下文"
                                                       Margin="0,2,0,8"
