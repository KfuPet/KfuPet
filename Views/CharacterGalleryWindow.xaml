<Window x:Class="KfuPet.Views.CharacterGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色模型"
        Width="900"
        Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <!-- 细滚动条：overlay 悬浮在内容上方，不挤压布局 -->
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource AppBorderBrush}"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Width="6"
                                       Margin="0,4,2,4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏图标按钮：悬停背景淡入 -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="HoverBg"
                                    Background="{DynamicResource AppBorderBrush}"
                                    CornerRadius="6"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮：悬停时红色背景淡入，右上角跟随窗口圆角 -->
        <Style x:Key="TitleBarCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="HoverBg" Background="#E81123" CornerRadius="0,10,0,0" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：标题 + 数量 + 搜索 + 刷新 + 打开文件夹 + 关闭 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIcon}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="角色模型"
                                   Margin="10,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountText"
                                   Margin="10,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,54,0">
                        <!-- 搜索框：名称 / 作者 / 标签 -->
                        <Grid Width="210" Height="30" Margin="0,0,10,0">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid Margin="9,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource FontFamilyIcon}"
                                           FontSize="{StaticResource FontSizeIconSmall}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Margin="7,0,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource FontFamilyBody}"
                                         FontSize="{StaticResource FontSizeCaption}"
                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AppTextPrimaryBrush}"
                                         SelectionBrush="{DynamicResource AppAccentBrush}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholderText"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Text="搜索名称 / 作者 / 标签"
                                           FontFamily="{StaticResource FontFamilyBody}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource AppTextDisabledBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <Button x:Name="RefreshButton"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                ToolTip="重新扫描模型列表"
                                Click="RefreshButton_Click">
                            <TextBlock x:Name="RefreshIcon"
                                       Text="&#xE72C;"
                                       FontFamily="{StaticResource FontFamilyIcon}"
                                       FontSize="{StaticResource FontSizeIcon}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>

                        <Button x:Name="OpenFolderButton"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                ToolTip="在资源管理器中打开模型文件夹"
                                Click="OpenFolderButton_Click">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource FontFamilyIcon}"
                                       FontSize="{StaticResource FontSizeIcon}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIconTiny}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 模型卡片列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="CardScroll"
                              Style="{StaticResource OverlayScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModelList"
                                  Margin="12,14,10,14"
                                  Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 一张模型卡片：预览图 + 名称 + 作者（头像） + 描述 + 标签，悬停时轻微上浮 -->
                                <Border x:Name="CardRoot"
                                        Width="184"
                                        Margin="8"
                                        CornerRadius="12"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="246"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 预览图 -->
                                        <Grid Grid.Row="0">
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    CornerRadius="11,11,0,0"/>
                                            <Rectangle RadiusX="11" RadiusY="11">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding PreviewImage}"
                                                                Stretch="UniformToFill"/>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <StackPanel x:Name="PreviewPlaceholder"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="&#xE91B;"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamilyIcon}"
                                                           FontSize="28"
                                                           Foreground="{DynamicResource AppTextDisabledBrush}"/>
                                                <TextBlock Text="暂无预览图"
                                                           Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="{DynamicResource AppTextDisabledBrush}"/>
                                            </StackPanel>

                                            <Border x:Name="InvalidBadge"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Padding="7,2"
                                                    Background="{DynamicResource AppPinkBrush}"
                                                    CornerRadius="4">
                                                <TextBlock Text="无效"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeIconSmall}"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <!-- 信息区 -->
                                        <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <StackPanel x:Name="ValidPanel">
                                                <!-- 作者行：头像 + 作者名 + 版本号（用 Grid 列约束宽度，长名字自动省略） -->
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="18" Height="18" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource AppBorderBrush}"/>
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AuthorAvatar}"
                                                                            Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock x:Name="AvatarInitial"
                                                                   Visibility="Collapsed"
                                                                   Text="{Binding AuthorInitial}"
                                                                   FontFamily="{StaticResource FontFamilyBody}"
                                                                   FontSize="{StaticResource FontSizeIconTiny}"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Author}"
                                                               Margin="6,0,0,0"
                                                               FontFamily="{StaticResource FontFamilyBody}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2"
                                                               x:Name="VersionText"
                                                               Text="{Binding VersionText}"
                                                               Margin="6,0,0,0"
                                                               FontFamily="{StaticResource FontFamilyBody}"
                                                               FontSize="{StaticResource FontSizeIconTiny}"
                                                               Foreground="{DynamicResource AppTextDisabledBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- 描述：固定三行高度，超出裁切 -->
                                                <Grid Height="51" Margin="0,8,0,0" ClipToBounds="True">
                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="17"
                                                               FontFamily="{StaticResource FontFamilyBody}"
                                                               FontSize="{StaticResource FontSizeIconSmall}"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               VerticalAlignment="Top"/>
                                                </Grid>

                                                <TextBlock x:Name="TagsText"
                                                           Text="{Binding TagsText}"
                                                           Margin="0,6,0,0"
                                                           FontFamily="{StaticResource FontFamilyBody}"
                                                           FontSize="{StaticResource FontSizeIconTiny}"
                                                           Foreground="{DynamicResource AppTextDisabledBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- 无效模型：显示原因 -->
                                            <TextBlock x:Name="InvalidReasonText"
                                                       Visibility="Collapsed"
                                                       Text="{Binding InvalidReason}"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{StaticResource FontFamilyBody}"
                                                       FontSize="{StaticResource FontSizeIconSmall}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- 悬停描边 -->
                                        <Border x:Name="HoverRing"
                                                Grid.RowSpan="2"
                                                CornerRadius="12"
                                                BorderThickness="1.5"
                                                BorderBrush="{DynamicResource AppAccentBrush}"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="ValidPanel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="InvalidBadge" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="InvalidReasonText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter TargetName="PreviewPlaceholder" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AuthorAvatar}" Value="{x:Null}">
                                        <Setter TargetName="AvatarInitial" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VersionText}" Value="">
                                        <Setter TargetName="VersionText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                        <Setter TargetName="TagsText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     To="-4" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     To="0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 加载状态 -->
                <TextBlock x:Name="LoadingText"
                           Visibility="Collapsed"
                           Text="正在扫描模型…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource FontFamilyBody}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <!-- 空状态：没有模型 / 搜索无结果 -->
                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="&#xE77B;"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource FontFamilyIcon}"
                               FontSize="40"
                               Foreground="{DynamicResource AppTextDisabledBrush}"/>
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="还没有角色模型"
                               Margin="0,12,0,4"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyStateHint"
                               Text="把角色文件夹放入 Characters 目录，并在文件夹中添加 character.json 即可显示。"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource AppTextDisabledBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>