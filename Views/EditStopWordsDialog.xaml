<Window x:Class="KfuPet.Views.EditStopWordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑停用词"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="DialogTitleText"
                               Text="编辑停用词"
                               Margin="16,0,0,0"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton"
                            Width="46" Height="44"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Border x:Name="HoverBg" Background="{DynamicResource AppDangerBrush}" CornerRadius="0,10,0,0" Opacity="0"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIconTiny}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="20,20,20,0">
                <TextBlock x:Name="DialogDescriptionText"
                           Text="这里列出我回忆时用来过滤虚词的关键词。用中英文逗号或换行分隔，保存后立即生效。"
                           FontFamily="{StaticResource FontFamilyBody}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="FieldLabelText"
                           Text="停用词"
                           Margin="0,16,0,4"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="StopWordsEditor"
                         Style="{StaticResource FieldInputStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         MinHeight="240"/>
            </StackPanel>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Content="取消"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource AppAccentBrush}"
                            Foreground="{DynamicResource AppAccentForegroundBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Content="保存"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
