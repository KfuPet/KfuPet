<Window x:Class="KfuPet.Views.AddModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加模型"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <!-- 字段错峰入场：透明度 + 轻微上移，逐项延迟 60ms（由代码后置在窗口加载后播放） -->
        <Storyboard x:Key="FormFieldsStagger">
            <DoubleAnimation Storyboard.TargetName="NameGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NameGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BaseUrlGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BaseUrlGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ApiKeyGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ApiKeyGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ModelIdGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" BeginTime="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ModelIdGroup"
                             Storyboard.TargetProperty="RenderTransform.Y"
                             From="8" To="0" Duration="0:0:0.24" BeginTime="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 圆角卡片：Margin 为投影留出空间 -->
    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="DialogTitleText"
                               Text="添加模型"
                               Margin="16,0,0,0"
                               FontFamily="{DynamicResource FontFamilyBody}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="{DynamicResource FontWeightSemiBold}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 表单内容 -->
            <StackPanel Grid.Row="1" Margin="20,20,20,0">
                <!-- 连接失败提示横幅：默认隐藏，失败时淡入并轻微下滑 -->
                <Border x:Name="ErrorBanner"
                        Style="{StaticResource DialogErrorBannerStyle}"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform Y="-6"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE783;"
                                   FontFamily="{DynamicResource FontFamilyIcon}"
                                   FontSize="{DynamicResource FontSizeIcon}"
                                   Foreground="#E81123"
                                   VerticalAlignment="Top"
                                   Margin="0,1,8,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接失败，请检查服务商、Base URL 与 API Key 是否正确"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="{DynamicResource FontWeightSemiBold}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ErrorDetailText"
                                       Margin="0,4,0,0"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="NameGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="显示名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ModelNameBox" Style="{StaticResource FieldInputStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="BaseUrlGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="BaseUrlBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 LostFocus="BaseUrlBox_LostFocus"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ApiKeyGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Style="{StaticResource FieldPasswordStyle}"
                                     LostFocus="ApiKeyBox_LostFocus"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ModelIdGroup">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="模型 ID（可从下拉选择服务商可用模型，也可手动填写）" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ModelIdBox"
                                  Style="{StaticResource FieldComboStyle}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  DropDownOpened="ModelIdBox_DropDownOpened"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Content="取消"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource AppSuccessBrush}"
                            Foreground="{DynamicResource AppSuccessForegroundBrush}"
                            BorderBrush="{DynamicResource AppSuccessBrush}"
                            Click="ConfirmButton_Click">
                        <Grid>
                            <TextBlock x:Name="ConfirmText"
                                       Text="添加"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="ConfirmSpinner"
                                  Width="16" Height="16"
                                  Data="M 15,8 A 7,7 0 0 1 8,15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5"
                                  Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ConfirmSpinnerRotate"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>