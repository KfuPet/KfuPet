<Window x:Class="KfuPet.Views.AnnouncementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公告"
        Width="440"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{x:Null}">

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="官方公告"
                               Margin="16,0,0,0"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1" Margin="24,24,24,16">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            Margin="0,0,16,0"
                            CornerRadius="24"
                            Background="{DynamicResource AppSurfaceBrush}"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="StatusIcon"
                                   Text="&#xE946;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIconLarge}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitleText"
                                   Text="公告"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LevelBadge"
                                    Background="#1A0078FF"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="LevelText"
                                           Text="公告"
                                           FontFamily="{StaticResource FontFamilyBody}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="DateText"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 公告正文：Markdown 渲染，过长时在卡片内滚动 -->
                <Border x:Name="BodyCard"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                    <ScrollViewer Style="{StaticResource OverlayScrollViewerStyle}"
                                  MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BodyPanel" Margin="0,0,12,0"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LinkButton"
                            Style="{StaticResource DialogButtonStyle}"
                            MinWidth="72"
                            Padding="14,6"
                            FontSize="{StaticResource FontSizeCaption}"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Content="查看详情"
                            Visibility="Collapsed"
                            Click="LinkButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DialogButtonStyle}"
                            MinWidth="72"
                            Padding="14,6"
                            FontSize="{StaticResource FontSizeCaption}"
                            Background="{DynamicResource AppAccentBrush}"
                            Foreground="{DynamicResource AppAccentForegroundBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Content="知道了"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
