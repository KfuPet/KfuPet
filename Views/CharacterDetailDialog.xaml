<Window x:Class="KfuPet.Views.CharacterDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色介绍"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="{x:Null}">

    <Window.Resources>
        <!-- 标签胶囊 -->
        <Style x:Key="TagChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogRoot"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="{StaticResource FontFamilyIcon}"
                                   FontSize="{StaticResource FontSizeIcon}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="角色介绍"
                                   Margin="10,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource DialogCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="关闭"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区：左侧预览图，右侧角色信息与完整简介 -->
            <Grid Grid.Row="1" Margin="20,18,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 预览图 -->
                <Grid Grid.Column="0" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="296"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"/>
                        <Rectangle RadiusX="10" RadiusY="10">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding PreviewImage}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE91B;"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource FontFamilyIcon}"
                                       FontSize="{StaticResource FontSizeIconExtraLarge}"
                                       Foreground="{DynamicResource AppTextDisabledBrush}"/>
                            <TextBlock Text="暂无预览图"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeIconSmall}"
                                       Foreground="{DynamicResource AppTextDisabledBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 角色信息 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 名称 -->
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{StaticResource FontFamilyDisplay}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 作者 + 版本号 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AppBorderBrush}"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AuthorAvatar}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding AuthorInitial}"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeIconTiny}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AuthorAvatar}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Author}"
                                   Margin="7,0,0,0"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeIconSmall}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Border Grid.Column="2"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppSurfaceBrush}"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VersionText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding VersionText}"
                                       FontFamily="{StaticResource FontFamilyBody}"
                                       FontSize="{StaticResource FontSizeIconTiny}"
                                       Foreground="{DynamicResource AppTextDisabledBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 标签 -->
                    <ItemsControl Grid.Row="2"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding Tags}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChipStyle}">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource FontFamilyBody}"
                                               FontSize="{StaticResource FontSizeIconSmall}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 完整简介 -->
                    <TextBlock Grid.Row="3"
                               Text="角色简介"
                               Margin="0,14,0,6"
                               FontWeight="{StaticResource FontWeightSemiBold}"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ScrollViewer Grid.Row="4"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,0,8,0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   FontFamily="{StaticResource FontFamilyBody}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </ScrollViewer>

                    <!-- 无效角色包：显示原因 -->
                    <TextBlock Grid.Row="5"
                               Text="{Binding InvalidReason}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource FontFamilyBody}"
                               FontSize="{StaticResource FontSizeIconSmall}"
                               Foreground="{DynamicResource AppPinkBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- 按钮栏 -->
            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,12">
                <Button Style="{StaticResource DialogButtonStyle}"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        Content="关闭"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
