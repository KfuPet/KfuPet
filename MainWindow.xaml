<Window x:Class="KfuPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:KfuPet.Controls"
        mc:Ignorable="d"
        Title="KfuPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp"
          MouseLeave="RootGrid_MouseLeave">
        <controls:CharacterCanvas x:Name="CharacterCanvas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

        <!-- AI 聊天气泡：右上角，收到回复后分批显示 -->
        <Border x:Name="ChatBubble"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16,16,16,0"
                MaxWidth="300"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <TextBlock x:Name="ChatBubbleText"
                       FontFamily="{StaticResource FontFamilyBody}"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 悬停输入框：悬停在角色上时从底部滑出 -->
        <Border x:Name="ChatInputPanel"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="16,0,16,20"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6"
                Opacity="0"
                Visibility="Collapsed"
                MouseEnter="ChatInputPanel_MouseEnter"
                MouseLeave="ChatInputPanel_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.25" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="8"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ChatInputBox"
                         Padding="8,6"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{StaticResource FontFamilyBody}"
                         FontSize="{StaticResource FontSizeBody}"
                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                         CaretBrush="{DynamicResource AppTextPrimaryBrush}"
                         VerticalContentAlignment="Center"
                         TextChanged="ChatInputBox_TextChanged"
                         KeyDown="ChatInputBox_KeyDown"/>
                <TextBlock x:Name="ChatInputHint"
                           Text="和我说点什么吧…"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="{StaticResource FontFamilyBody}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource AppTextDisabledBrush}"/>

                <Button x:Name="ChatSendButton"
                        Grid.Column="1"
                        Padding="12,6"
                        Margin="4,0,0,0"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="{DynamicResource AppAccentForegroundBrush}"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="ChatSendButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SendBg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <TextBlock Text="发送"
                                           FontFamily="{StaticResource FontFamilyBody}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SendBg"
                                            Property="Background"
                                            Value="{DynamicResource AppAccentHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid.Resources>
            <Storyboard x:Key="FadeInStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootGrid"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
    </Grid>
</Window>
