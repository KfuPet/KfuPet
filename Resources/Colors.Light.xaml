<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题配色令牌 -->

    <!-- 背景与表面 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF7F7F9"/>

    <!-- 文本 -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF1A1A1E"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF6B6B76"/>
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="#FFB4B4BC"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFE5E5EA"/>

    <!-- 品牌强调色（中性灰） -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF4A4A55"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF33333D"/>
    <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFFFF"/>

    <!-- 成功/开启（开关） -->
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF34C759"/>

    <!-- 功能色：信息（发送按钮） -->
    <SolidColorBrush x:Key="AppInfoBrush" Color="#FF2F6BFF"/>
    <SolidColorBrush x:Key="AppInfoHoverBrush" Color="#FF1E56D9"/>
    <SolidColorBrush x:Key="AppInfoForegroundBrush" Color="#FFFFFFFF"/>

    <!-- 功能色：成功（添加按钮 / 我的消息） -->
    <SolidColorBrush x:Key="AppSuccessHoverBrush" Color="#FF2DB84F"/>
    <SolidColorBrush x:Key="AppSuccessForegroundBrush" Color="#FF1A1A1E"/>

    <!-- 功能色：记忆等级（浅红） -->
    <SolidColorBrush x:Key="AppPinkBrush" Color="#FFE06B6B"/>
</ResourceDictionary>
