<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题配色令牌 -->

    <!-- 背景与表面 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF2A2A30"/>

    <!-- 文本 -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFF2F2F5"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFA0A0AB"/>
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="#FF5A5A64"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3A3A42"/>

    <!-- 品牌强调色（中性灰） -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF9A9AA6"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FFB0B0BA"/>
    <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FF1A1A1E"/>

    <!-- 成功/开启（开关） -->
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF34C759"/>

    <!-- 功能色：信息（发送按钮） -->
    <SolidColorBrush x:Key="AppInfoBrush" Color="#FF2F6BFF"/>
    <SolidColorBrush x:Key="AppInfoHoverBrush" Color="#FF1E56D9"/>
    <SolidColorBrush x:Key="AppInfoForegroundBrush" Color="#FFFFFFFF"/>

    <!-- 功能色：成功（添加按钮 / 我的消息） -->
    <SolidColorBrush x:Key="AppSuccessHoverBrush" Color="#FF2DB84F"/>
    <SolidColorBrush x:Key="AppSuccessForegroundBrush" Color="#FF1A1A1E"/>

    <!-- 功能色：记忆等级（浅红） -->
    <SolidColorBrush x:Key="AppPinkBrush" Color="#FFF0A0A0"/>
</ResourceDictionary>
