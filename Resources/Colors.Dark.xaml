<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题配色令牌 -->

    <!-- 背景与表面 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF2A2A30"/>

    <!-- 文本 -->
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFF2F2F5"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFA0A0AB"/>
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="#FF5A5A64"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3A3A42"/>

    <!-- 品牌强调色 -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF8B6BFF"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FFA58BFF"/>
    <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFFFF"/>
</ResourceDictionary>
